{
  "manifest_version": 3,
  "name": "PaletteSniffer - 调色盘嗅探器",
  "description": "自动分析当前网页配色，提取主色调并生成配色方案",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "调色盘嗅探器"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
